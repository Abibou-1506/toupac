{
    email admin@toupac.sn
}

{$DOMAIN:localhost} {
    # API et Admin
    handle /api/* {
        reverse_proxy web:8000
    }
    handle /admin/* {
        reverse_proxy web:8000
    }
    handle /health/* {
        reverse_proxy web:8000
    }

    # WebSocket
    handle /ws/* {
        reverse_proxy ws:8001
    }

    # Static files
    handle /static/* {
        root * /srv
        file_server
    }

    # Media files
    handle /media/* {
        root * /srv
        file_server
    }

    # Tout le reste → web
    handle {
        reverse_proxy web:8000
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
