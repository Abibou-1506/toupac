# TOUPAC Production Environment Variables
# Copier vers .env.prod et remplir les valeurs

# Django
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=api.toupac.sn,toupac.sn

# Database
DB_NAME=toupac
DB_USER=toupac
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_CONCURRENCY=4
WEB_WORKERS=4

# Domain (for Caddy TLS)
DOMAIN=api.toupac.sn

# Intouch (mobile money)
INTOUCH_LOGIN_AGENT=
INTOUCH_PASSWORD_AGENT=
INTOUCH_PARTNER_ID=

# QR billets — clé privée RS256 multi-lignes (générée avec
# scripts/generate_qr_keypair.py). NE JAMAIS COMMITTER LA CLÉ RÉELLE.
TOUPAC_QR_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

TOUPAC_QR_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
