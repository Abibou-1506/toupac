# TOUPAC Production Environment Variables
# Copier vers .env.prod et remplir les valeurs

# Django
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=api.toupac.sn,toupac.sn

# Database
DB_NAME=toupac
DB_USER=toupac
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_CONCURRENCY=4
WEB_WORKERS=4

# Domain (for Caddy TLS)
DOMAIN=api.toupac.sn

# Intouch (mobile money)
INTOUCH_LOGIN_AGENT=
INTOUCH_PASSWORD_AGENT=
INTOUCH_PARTNER_ID=

# JWT QR (générer avec : openssl genrsa -out private.pem 2048)
# QR_JWT_PRIVATE_KEY=
# QR_JWT_PUBLIC_KEY=
